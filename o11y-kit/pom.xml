<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.o11y.kit</groupId>
    <artifactId>o11y-kit</artifactId>
    <version>0.4.0-beta</version>
    <packaging>pom</packaging>
    <name>o11y-kit</name>
    <description>Lightweight, non-invasive HTTP observability SDK for Spring Boot</description>

    <modules>
        <module>o11y-kit-api</module>
        <module>o11y-kit-micrometer</module>
        <module>o11y-kit-spring-webmvc</module>
        <module>o11y-kit-spring-webflux</module>
        <module>o11y-kit-spring-aop</module>
        <module>o11y-kit-spring-boot-autoconfigure</module>
        <module>o11y-kit-spring-boot-starter</module>
        <module>o11y-kit-test</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.boot.version>3.4.3</spring.boot.version>
        <micrometer.version>1.14.5</micrometer.version>
        <opentelemetry.version>1.37.0</opentelemetry.version>
        <junit.version>5.11.4</junit.version>
        <mockito.version>5.23.0</mockito.version>
        <spotbugs.version>4.8.6.6</spotbugs.version>
        <findsecbugs.version>1.13.0</findsecbugs.version>
        <checkstyle.version>3.4.0</checkstyle.version>
        <errorprone.version>2.28.0</errorprone.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-bom</artifactId>
                <version>${micrometer.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Intra-project dependencies -->
            <dependency>
                <groupId>io.o11y.kit</groupId>
                <artifactId>o11y-kit-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.o11y.kit</groupId>
                <artifactId>o11y-kit-micrometer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.o11y.kit</groupId>
                <artifactId>o11y-kit-spring-webmvc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.o11y.kit</groupId>
                <artifactId>o11y-kit-spring-webflux</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.o11y.kit</groupId>
                <artifactId>o11y-kit-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.o11y.kit</groupId>
                <artifactId>o11y-kit-spring-aop</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- JaCoCo: always active for o11y-kit modules (NOT in a profile) -->
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <!--
                                Report-only initially. Set haltOnFailure=true once
                                coverage baseline is established and modules reach 80%.
                            -->
                            <haltOnFailure>false</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <!-- Exclude boilerplate classes from coverage requirements -->
                            <excludes>
                                <exclude>**/*Application.*</exclude>
                                <exclude>**/*Properties.*</exclude>
                                <exclude>**/*AutoConfiguration.*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            static-analysis profile: SpotBugs + Checkstyle.
            Run: mvn verify -P static-analysis
            Report-only — does NOT fail the build (failOnError/failsOnError = false).
            Enable required status check after baseline is established.
        -->
        <profile>
            <id>static-analysis</id>
            <build>
                <plugins>
                    <!-- SpotBugs with FindSecBugs -->
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>${spotbugs.version}</version>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Medium</threshold>
                            <failOnError>false</failOnError>
                            <excludeFilterFile>config/spotbugs-exclude.xml</excludeFilterFile>
                        </configuration>
                        <executions>
                            <execution>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                        <dependencies>
                            <dependency>
                                <groupId>com.h3xstream.findsecbugs</groupId>
                                <artifactId>findsecbugs-plugin</artifactId>
                                <version>${findsecbugs.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>

                    <!-- Checkstyle (Google Java Style) -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-checkstyle-plugin</artifactId>
                        <version>${checkstyle.version}</version>
                        <configuration>
                            <configLocation>google_checks.xml</configLocation>
                            <failsOnError>false</failsOnError>
                            <violationSeverity>warning</violationSeverity>
                            <suppressionsLocation>config/checkstyle-suppressions.xml</suppressionsLocation>
                        </configuration>
                        <executions>
                            <execution>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Error Prone profile (separate from static-analysis for R2 mitigation).
            Run: mvn compile -P error-prone

            NOTE: Error Prone may require JDK-specific setup. If compilation fails
            due to JDK compatibility issues (e.g., annotation processor errors on JDK 21),
            disable this profile and rely on SpotBugs for static analysis instead.
            Workaround: set JAVA_HOME to JDK 17 or add -Derrorprone.disable=true
            to skip Error Prone without disabling the entire profile.
        -->
        <profile>
            <id>error-prone</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>3.11.0</version>
                        <configuration>
                            <release>${maven.compiler.release}</release>
                            <encoding>${project.build.sourceEncoding}</encoding>
                            <forceJavacCompilerUse>true</forceJavacCompilerUse>
                            <compilerArgs>
                                <arg>-Xplugin:ErrorProne</arg>
                            </compilerArgs>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${errorprone.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            JaCoCo exclusion for o11y-kit-test module.
            This module contains test harness stubs that throw UnsupportedOperationException
            and should not be subject to the 80% coverage gate.
        -->
        <profile>
            <id>o11y-kit-test-jacoco-skip</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.version}</version>
                        <executions>
                            <execution>
                                <id>check</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
