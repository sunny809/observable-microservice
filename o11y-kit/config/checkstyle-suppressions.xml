<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionXpathFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2_xpath.dtd">
<suppressions>
    <!--
        Checkstyle suppressions for o11y-kit.
        Initially suppress all existing files to establish a baseline.
        New files must pass Checkstyle checks without suppressions.
        Remove suppressions incrementally as existing code is cleaned up.
    -->
    <suppress files=".*" checks=".*"/>
</suppressions>
